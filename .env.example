# Copy to .env and fill locally. NEVER commit .env
DB_URL=jdbc:postgresql://localhost:5432/roomfinder
DB_USER=roomfinder
DB_PASSWORD=localdev

AUTH_JWT_SECRET=
OTP_PROVIDER=log
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=roomfinder-media
SENTRY_DSN=
MEDIA_ROOT=./data/media

# --- production server only: /srv/roomfinder/.env on each VM (see docs/ops/deployment.md) ---
# Compose refuses to start without DB_PASSWORD, AUTH_JWT_SECRET, OTP_PROVIDER and DOMAIN.
# KEY=value, no spaces around '=', no quotes: scripts read this file as shell too.
ENVIRONMENT=            # staging or production; names the backup folder in R2
DOMAIN=                 # e.g. app.example.com; Caddy gets the certificate for it
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=
BACKUP_PING_URL=        # optional dead-man's-switch URL pinged after each good backup
